# Copie este archivo como .env y complete los valores reales.
# NUNCA suba el archivo .env al repositorio.

DJANGO_SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Motor de base de datos: mysql (MariaDB) o sqlite (solo para pruebas)
DB_ENGINE=mysql
DB_NAME=sonrisa_perfecta
DB_USER=sonrisa_user
DB_PASSWORD=cambie-esta-clave
DB_HOST=127.0.0.1
DB_PORT=3306
